# Impect API credentials.
#   cp .env.example .env   &&   chmod 600 .env   &&   edit .env
# .env is gitignored. Never commit it, email it, or paste it into a chat.

IMPECT_USER=you@example.com
IMPECT_PASS=replace-me

# Unset = state/processed.json on local disk - fine for solo local testing,
# not for deployment (webapp + scheduler are separate processes and need
# to see the same state). Set = Postgres instead - see db.py and
# docker-compose.yml. For local testing against the compose Postgres:
#   DATABASE_URL=postgresql://match_analysis:devpassword@localhost:5432/match_analysis
#
# PRODUCTION: "devpassword" above is a local-only default baked into
# docker-compose.yml - set a real POSTGRES_PASSWORD and a matching
# DATABASE_URL here before deploying, or the droplet's database is sitting
# behind a password that's sitting in this repo's own history.
DATABASE_URL=

# Anthropic API key - powers the free-text interpretation layer (coach's
# notes -> Coach's Brief checks, and "last N games" -> match selection).
# See brief_interpreter.py / selector_interpreter.py.
ANTHROPIC_API_KEY=

# webapp.py login - one entry per person, "username:encoded-hash" pairs
# separated by commas. Generate each with:
#   python3 auth.py "that person's password"
# (prints "username:..." - replace "username" with the real one, then
# comma-join multiple people on this one line). Required once webapp.py is
# reachable from outside localhost - without this set, AUTH_USERS is empty
# and nobody can sign in at all (fails closed, not open). Add or remove a
# person by editing this line and restarting the webapp container - no
# code change, no migration.
#
# Must be the base64-encoded form auth.py prints, not a raw werkzeug hash
# pasted in by hand - a raw hash contains "$", which `docker compose`
# silently mangles while parsing this file for its own variable
# substitution, corrupting the hash and locking that person out.
AUTH_USERS=

# Session cookie signing key - required in production. Without it, a
# random key is generated at process start, which means every gunicorn
# worker (and every restart) signs sessions differently and people get
# logged out at random. Generate one once with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Set to 1 only once a reverse proxy in front of webapp is actually
# terminating TLS (see deploy/CADDY_SETUP.md) - marks the session cookie
# Secure, so browsers refuse to send it back over plain HTTP. Leave unset
# for local/Docker testing without a proxy, or login cookies won't
# round-trip at all.
FORCE_HTTPS=
