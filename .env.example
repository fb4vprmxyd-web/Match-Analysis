# Impect API credentials.
#   cp .env.example .env   &&   chmod 600 .env   &&   edit .env
# .env is gitignored. Never commit it, email it, or paste it into a chat.

IMPECT_USER=you@example.com
IMPECT_PASS=replace-me

# Optional. Unset = state/processed.json on local disk (today's behaviour).
# Set = the processed-matches ledger lives in Postgres instead - see db.py
# and docker-compose.yml. For local testing against the compose Postgres:
#   DATABASE_URL=postgresql://match_analysis:devpassword@localhost:5432/match_analysis
DATABASE_URL=
